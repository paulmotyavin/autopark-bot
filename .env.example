# ---- Telegram ----
BOT_TOKEN=123456:replace-me
# Исходящий прокси ТОЛЬКО для запросов к api.telegram.org (Нидерланды). Пусто = без прокси.
# Формат: socks5://user:pass@host:port  или  http://user:pass@host:port
TELEGRAM_PROXY=
# Telegram ID первого владельца: создаётся/повышается до owner при каждом старте
OWNER_TG_ID=123456789

# ---- PostgreSQL (облачный, managed) ----
# Хост, порт и данные из консоли провайдера. БД держите в приватной сети провайдера
# или с доступом только с IP сервера бота. Для локальной разработки: docker-compose.dev.yml
DB_HOST=db.example.cloud
DB_PORT=5432
DB_USER=autopark
DB_PASSWORD=change-me-long-random
DB_NAME=autopark
# TLS до БД: require | verify-ca | verify-full (для локальной БД оставить пустым)
DB_SSL_MODE=require

# ---- Redis (FSM) ----
REDIS_URL=redis://redis:6379/0

# ---- S3 (приватный bucket, отдельный ключ только на него) ----
S3_ENDPOINT_URL=https://s3.example.com
S3_REGION=ru-1
S3_BUCKET=autopark-private
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# ---- Приложение ----
TIMEZONE=Europe/Moscow
INVITE_TTL_HOURS=72
# Внешний мониторинг (healthchecks.io или аналог). Пусто = выключен.
HEALTHCHECK_URL=
LOG_LEVEL=INFO
# pretty | json
LOG_FORMAT=json
